{
  "id": "/tekagon-admin",
  "name": "Tekagon Admin",
  "short_name": "Tekagon Admin",
  "description": "Tekagon admin dashboard for users, tickets, chat, content, and settings.",
  "start_url": "/pages/admin.html?source=pwa",
  "scope": "/pages/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#111722",
  "theme_color": "#111722",
  "orientation": "portrait-primary",
  "categories": ["business", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/Images/pwa-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/Images/pwa-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/Images/pwa-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/Images/pwa-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
