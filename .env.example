# Frontend production build variables.
# These values are public in the browser after build. Do not put private secrets here.

VITE_PUBLIC_API_URL=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: only set these if the landing page uses a different Firebase project.
VITE_INDEX_FIREBASE_API_KEY=
VITE_INDEX_FIREBASE_AUTH_DOMAIN=
VITE_INDEX_FIREBASE_PROJECT_ID=
VITE_INDEX_FIREBASE_STORAGE_BUCKET=
VITE_INDEX_FIREBASE_MESSAGING_SENDER_ID=
VITE_INDEX_FIREBASE_APP_ID=
VITE_INDEX_FIREBASE_MEASUREMENT_ID=

# Public Cloudinary unsigned-upload configuration for admin image uploads.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
